# overlay-lab 設定範本：複製成 .env 後填值（.env 已被 .gitignore 忽略，不要 commit）
#   cp .env.example .env
# docker compose 會讀 .env；直接用 `python -m app` 跑時請自行 export 這些變數。

# ---- Google Vision（Mode A 要字框，Mode B 的 OCR 驗證也用它）-------------------------------
# 方法 1（預設，不落地）：掛載正式機既有的外部 volume linebot-translator-secrets（唯讀），
#   檔案在 /run/secrets/linebot.json。這是 docker-compose.yml 的預設值，下面這行可以不填。
# 方法 2：Vision JSON 放在主機上，把 compose 裡標 (2) 的區塊打開，並填：
#   GOOGLE_APPLICATION_CREDENTIALS=/secrets/vision.json
#   VISION_CREDENTIALS_FILE=/path/on/host/vision.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/linebot.json
VISION_CREDENTIALS_FILE=

# ---- Anthropic（Mode A 的分組與翻譯）--------------------------------------------------------
ANTHROPIC_API_KEY=
# 預設 claude-opus-5-5。內建價目表只有 claude-opus-5-5、claude-sonnet-5-5、claude-haiku-5-5；
# 其他型號只顯示 tokens，不估費用。
CLAUDE_MODEL=claude-opus-5-5

# ---- OpenRouter（Mode B 的影像模型）---------------------------------------------------------
# 正式機的變數名稱是 OPEN_ROUTE_API_KEY，兩個名稱擇一填即可（兩個都填時用 OPENROUTER_API_KEY）。
OPENROUTER_API_KEY=
OPEN_ROUTE_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# auto：先走 chat/completions（modalities: image,text），不行再走 /api/v1/images；
# chat 或 images：只走那一條。
OPENROUTER_IMAGE_API=auto
# 選填：送給 OpenRouter 的 HTTP-Referer（也接受 OPEN_ROUTE_HTTP_REFERER）
OPENROUTER_HTTP_REFERER=

# ---- 這個工具本身 ---------------------------------------------------------------------------
# 設了之後，每個請求都要帶 ?token=<值> 或標頭 X-Lab-Token，否則 401。
# 只要伺服器不是只有你自己連得到，就一定要設。
LAB_TOKEN=
LAB_PORT=4041
# 1 = 完全不打網路（Vision / Claude / OpenRouter 換成內建 fixture），用來試跑 erase + render
LAB_MOCK=0
# 上傳與輸出的存放處（容器內固定是 /app/data，compose 把 ./data 掛進去）
LAB_DATA_DIR=./data
# 文字顏色取樣：取字框內「離背景最遠」的這個比例的像素的中位數（預設 0.40）。
# 細小的字邊緣多、顏色會偏淡，調小（例如 0.2）會比較深。
LAB_INK_FRACTION=0.40
# 選填：指定字型檔（預設在系統字型目錄找 Noto Sans CJK 與 DejaVu Sans）
# LAB_FONT_CJK=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# LAB_FONT_CJK_BOLD=/usr/share/fonts/opentype/noto/NotoSansCJK-Bold.ttc
# LAB_FONT_LATIN=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# LAB_FONT_LATIN_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
