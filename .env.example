# 此檔列出應用程式實際綁定的環境變數、預設值與用途；複製成 .env 後依需要修改（.env 不會進版控）。
# 機密欄位（token、secret、API key、連線字串）只放佔位值或留空，不可提交真實值。
# 正式部署由 .github/workflows/ci-cd.yml 與 scripts/deploy.sh 傳入，見 deployment-guide.md。

# 伺服器配置
# HTTP 監聽 port，預設 4040
SERVER_PORT=4040

# LINE Bot 配置
# LINE Messaging API channel access token（機密，必填，無預設值）
LINE_BOT_CHANNEL_TOKEN=your_line_bot_channel_token
# LINE channel secret，用於驗證 webhook 簽章（機密，必填，無預設值）
LINE_BOT_CHANNEL_SECRET=your_line_bot_channel_secret

# MongoDB 配置
# 連線字串（含帳密，機密）；未設定時預設 mongodb://localhost:27017/linebot_translator
MONGODB_URI=mongodb://username:password@localhost:27017/linebot_translator?authSource=admin
# 資料庫名稱，預設 linebot_translator
MONGODB_DATABASE=linebot_translator
# socket 連線 timeout（毫秒），預設 3000
MONGODB_CONNECT_TIMEOUT_MS=3000
# socket 讀取 timeout（毫秒），預設 5000
MONGODB_READ_TIMEOUT_MS=5000
# 每次操作等待可用節點的上限（毫秒），預設 3000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
# 背景 topology 重新檢查間隔（毫秒），預設 5000
MONGODB_HEARTBEAT_FREQUENCY_MS=5000
# 背景重新檢查的最小間隔（毫秒），預設 500
MONGODB_MIN_HEARTBEAT_FREQUENCY_MS=500

# 有界翻譯快取配置（版本值變更時會安全失效舊項目）
# 快取項目寫入後的存活時間（ISO-8601 duration），同時限制 AI 語言偵測 memo，預設 PT30M
TRANSLATION_CACHE_TTL=PT30M
# 快取最大項目數，預設 1000
TRANSLATION_CACHE_MAX_ENTRIES=1000
# 詞彙表版本，變更後舊快取項目失效，預設 none
TRANSLATION_GLOSSARY_VERSION=none
# 翻譯 action claim 處理中超過此租約（程序中斷、完成寫入失敗）後可由下一次點擊接手，預設 PT5M
TRANSLATION_ACTION_CLAIM_LEASE=PT5M

# Webhook 非同步處理與去重配置
# 處理 executor 的核心執行緒數，預設 2
WEBHOOK_CORE_THREADS=2
# 處理 executor 的最大執行緒數，預設 4
WEBHOOK_MAX_THREADS=4
# 等待佇列容量；佇列已滿時回 503 交由 LINE 重送，預設 100
WEBHOOK_QUEUE_CAPACITY=100
# webhook receipt 保留時間（須長於處理租約），預設 P7D
WEBHOOK_RECEIPT_TTL=P7D
# 單一事件的處理租約，逾時可由其他 worker 接手，預設 PT5M
WEBHOOK_PROCESSING_LEASE=PT5M
# LINE reply 最多嘗試次數，預設 3
WEBHOOK_REPLY_MAX_ATTEMPTS=3
# LINE reply 重試間隔，預設 PT1S
WEBHOOK_REPLY_RETRY_BACKOFF=PT1S

# MongoDB 資料保留（ISO-8601 duration，以 TTL index 清除舊資料）；留空或 PT0S 代表停用該集合
# translation_records 保留期，預設 P90D
TRANSLATION_RECORD_RETENTION=P90D
# translation_action_claims 保留期，預設 P7D
TRANSLATION_ACTION_CLAIM_RETENTION=P7D
# ai_usage_events 保留期，預設 P730D
AI_USAGE_EVENT_RETENTION=P730D

# reply token 過期時改用 push 傳送答案；push 會消耗官方帳號每月訊息額度（reply 不會），每日上限以 UTC+8 計日
# 是否啟用 push 備援，預設 true
LINE_PUSH_FALLBACK_ENABLED=true
# 每日最多備援 push 則數，重啟後歸零，預設 100
LINE_PUSH_FALLBACK_DAILY_LIMIT=100

# OpenRouter 配置（唯一的 AI Provider；API key 的名稱固定為 OPEN_ROUTE_API_KEY）
# OpenRouter API key（機密，正式環境必填，無預設值）
OPEN_ROUTE_API_KEY=
# 全域預設模型 slug；使用者偏好與 /admin config model 可覆寫，預設 openai/gpt-4o-mini
OPEN_ROUTE_MODEL_NAME=openai/gpt-4o-mini
# OpenRouter API base URL，預設 https://openrouter.ai/api/v1
OPEN_ROUTE_API_URL=https://openrouter.ai/api/v1
# 選填：請求附帶的 HTTP-Referer 標頭，留空則不送出，預設為本專案 GitHub 網址
OPEN_ROUTE_HTTP_REFERER=https://github.com/AlienTechForge/LineBotTranslator
# 選填：請求附帶的 X-OpenRouter-Title 標頭，留空則不送出，預設 LineBotTranslator
OPEN_ROUTE_APP_TITLE=LineBotTranslator
# 模型 catalog 快取存活時間；零或負值視為預設，預設 PT15M
OPEN_ROUTE_CATALOG_TTL=PT15M

# Google Cloud Vision API 配置 (OCR)
# 指向 Google service account JSON，預設 ./linebot.json；正式環境改由 GOOGLE_CREDENTIALS_JSON secret 傳入（見 deployment-guide.md）
GOOGLE_APPLICATION_CREDENTIALS=./linebot.json
# 單次 Vision OCR 呼叫（含重試）的總時間上限（毫秒），預設 60000
GOOGLE_VISION_TIMEOUT_MS=60000

# 應用程式配置
# 是否啟用 Google Vision OCR；不可用時圖片改用 AI 辨識，預設 true
OCR_ENABLED=true
# 廣播測試模式：true 時管理員廣播只模擬、不實際發送訊息，預設 false
APP_BROADCAST_TEST_MODE=false

# 管理員配置
# ADMIN_USERS 只是 bootstrap seed：MongoDB 尚未保存管理員清單時才會使用（LINE user ID，逗號分隔，預設為空）。
# 管理員以 /admin add、/admin remove 做的變更會保存在 MongoDB（runtime_settings），
# 重啟或重新部署後仍有效；之後修改這個環境變數不會覆蓋已保存的清單。
ADMIN_USERS=your_admin_user_id
# 選填：圖片管理頁 /admin/images 的 Bearer token（機密）；留空（預設）則不註冊任何 /admin/images 路由。
# 建議使用 `openssl rand -hex 32` 產生的隨機值。
ADMIN_WEB_TOKEN=

# MinIO 配置：內部 S3 操作與外部 presigned URL 分離
# 內部 S3 API endpoint（應用程式直接存取），預設 http://localhost:9000
MINIO_ENDPOINT=http://127.0.0.1:9000
# 對外 presigned URL 的簽署 endpoint（使用者可連到的網址），預設同 MINIO_ENDPOINT
MINIO_PUBLIC_ENDPOINT=https://s3.example.com
# MinIO access key（機密）；正式環境啟用 MinIO 時必填且不可為出廠值 minioadmin，開發環境預設 minioadmin
MINIO_ACCESS_KEY=your_minio_access_key
# MinIO secret key（機密）；規則同 MINIO_ACCESS_KEY
MINIO_SECRET_KEY=your_minio_secret_key
# 儲存圖片的 bucket 名稱，預設 linebot-images
MINIO_BUCKET_NAME=linebot-images
# S3 region，預設 us-east-1
MINIO_REGION=us-east-1
# 是否啟用 optional 圖片儲存；停用或不可用時圖片翻譯仍可繼續，預設 true
MINIO_ENABLED=true
# MinIO 中斷後再次 probe 的間隔（毫秒），預設 30000
MINIO_RETRY_INTERVAL_MS=30000
# MinIO 連線 timeout（毫秒），預設 3000
MINIO_CONNECT_TIMEOUT_MS=3000
# MinIO 上傳 timeout（毫秒），預設 5000
MINIO_WRITE_TIMEOUT_MS=5000
# MinIO 讀取 timeout（毫秒），預設 5000
MINIO_READ_TIMEOUT_MS=5000

# 語言檢測配置
# 注意：application*.properties 尚未把下列兩個環境變數綁定到 app.language-detection.use-ai／default-chinese，
# 目前設定它們不會改變行為（內建值為 true 與 zh-tw）；部署 passthrough 暫時保留。
# 是否使用 AI 偵測語言，預設 true
LANGUAGE_DETECTION_USE_AI=true
# 中文文字的預設語言代碼，預設 zh-tw
LANGUAGE_DETECTION_DEFAULT_CHINESE=zh-tw

# 圖片翻譯配置
# 輸入圖片大小上限（bytes），預設 10485760
IMAGE_TRANSLATION_MAX_FILE_SIZE_BYTES=10485760
# 輸入圖片單邊像素上限，預設 4096
IMAGE_TRANSLATION_MAX_DIMENSION=4096
# 輸入圖片總像素上限，預設 16000000
IMAGE_TRANSLATION_MAX_PIXELS=16000000
# OCR 低信心門檻（大於 0 且至多 1），低於此值的文字視為不可靠，預設 0.60
IMAGE_TRANSLATION_LOW_CONFIDENCE_THRESHOLD=0.60
# 譯文覆蓋圖（overlay）採 fail-closed；設為 false 可立即停用，且不影響 OCR 與文字翻譯，預設 true
IMAGE_TRANSLATION_OVERLAY_ENABLED=true
# 單一文字區塊遮罩面積占整張圖的比例上限，預設 0.12
IMAGE_TRANSLATION_MAX_REGION_AREA_RATIO=0.12
# 全部遮罩面積合計占整張圖的比例上限（不得小於單一區塊上限），預設 0.35
IMAGE_TRANSLATION_MAX_TOTAL_MASK_RATIO=0.35
# 產生圖片的大小上限（bytes，LINE 原圖限制 10 MB）；PNG 超過時改輸出 JPEG 或縮小，預設 10485760
IMAGE_TRANSLATION_MAX_OUTPUT_BYTES=10485760
# 清除過期翻譯圖片（translated-images/）的排程間隔，預設 PT1H
IMAGE_TRANSLATION_CLEANUP_INTERVAL=PT1H
# 選填：/i/{token} proxy 的公開 base URL；留空（預設）則直接在 LINE ImageMessage 送出 MinIO／木雷 URL
IMAGE_PROXY_PUBLIC_BASE_URL=
# proxy token 有效期（不可長於 presigned URL），預設 PT55M
IMAGE_PROXY_TOKEN_TTL=PT55M
# 同時可解析的 proxy token 數量上限，預設 10000
IMAGE_PROXY_MAX_ENTRIES=10000
# preview 圖的位元組上限，預設 1048576
IMAGE_PROXY_PREVIEW_MAX_BYTES=1048576
# proxy 內容快取的存活時間，預設 PT5M
IMAGE_PROXY_CONTENT_CACHE_TTL=PT5M
# proxy 快取保留的 original + preview 位元組上限（64 MiB），預設 67108864；取代已不再生效的 IMAGE_PROXY_CONTENT_CACHE_ENTRIES
IMAGE_PROXY_CONTENT_CACHE_MAX_BYTES=67108864
# 翻譯圖片後是否再附上辨識文字、譯文與快速操作；部署預設值，管理員可用 /admin config image-text [on|off] 動態切換，預設 true
IMAGE_TEXT_REPLY_ENABLED=true

# 木雷短網址配置
# 部署預設開關（Mongo 尚無 persisted 值時使用；管理員可用 /admin config short-url 切換），預設 false
SHORT_URL_ENABLED=false
# 木雷 API：同主機固定 port 可用 http://127.0.0.1:18080；遠端必須 HTTPS（預設為空）
DWZ_API_BASE_URL=http://127.0.0.1:18080
# 木雷 Bearer API token（機密，預設為空）
DWZ_API_TOKEN=your_dwz_bearer_token
# 選填：指定木雷短域名；留空使用木雷預設 domain
DWZ_SHORT_DOMAIN=
# 選填：木雷 workspace ID，預設為空
DWZ_WORKSPACE_ID=
# 短網址有效期（不可長於 presigned URL），預設 PT55M
SHORT_URL_TTL=PT55M
