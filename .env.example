# 伺服器配置
SERVER_PORT=4040

# LINE Bot 配置
LINE_BOT_CHANNEL_TOKEN=your_line_bot_channel_token
LINE_BOT_CHANNEL_SECRET=your_line_bot_channel_secret

# MongoDB 配置
MONGODB_URI=mongodb://username:password@localhost:27017/linebot_translator?authSource=admin
MONGODB_DATABASE=linebot_translator
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_READ_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_HEARTBEAT_FREQUENCY_MS=5000
MONGODB_MIN_HEARTBEAT_FREQUENCY_MS=500

# 有界翻譯快取配置（版本值變更時會安全失效舊項目）
TRANSLATION_CACHE_TTL=PT30M
TRANSLATION_CACHE_MAX_ENTRIES=1000
TRANSLATION_STYLE=neutral
TRANSLATION_GLOSSARY_VERSION=none
TRANSLATION_PROMPT_VERSION=translation-v1

# Webhook 非同步處理與去重配置
WEBHOOK_CORE_THREADS=2
WEBHOOK_MAX_THREADS=4
WEBHOOK_QUEUE_CAPACITY=100
WEBHOOK_RECEIPT_TTL=P7D
WEBHOOK_PROCESSING_LEASE=PT5M
WEBHOOK_REPLY_MAX_ATTEMPTS=3
WEBHOOK_REPLY_RETRY_BACKOFF=PT1S

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL_NAME=gpt-4.1
# OpenAI 可用模型列表，使用逗號分隔
OPENAI_AVAILABLE_MODELS=gpt-4.1,o4-mini,o3-mini,o1-mini

# Gemini 配置
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL_NAME=gemini-2.0-flash-001
# Gemini 可用模型列表，使用逗號分隔
GEMINI_AVAILABLE_MODELS=gemini-2.0-flash,gemini-2.5-pro-preview-05-06

# Google Cloud Vision API 配置 (OCR)
# GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key
GOOGLE_APPLICATION_CREDENTIALS=./linebot.json

# 應用程式配置
OCR_ENABLED=true
AI_DEFAULT_PROVIDER=openai
APP_BROADCAST_TEST_MODE=false

# 管理員配置
ADMIN_USERS=your_admin_user_id

# MinIO 配置：內部 S3 操作與外部 presigned URL 分離
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_PUBLIC_ENDPOINT=https://s3.example.com
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET_NAME=line-bot
MINIO_REGION=us-east-1
MINIO_ENABLED=true
MINIO_RETRY_INTERVAL_MS=30000
MINIO_CONNECT_TIMEOUT_MS=3000
MINIO_WRITE_TIMEOUT_MS=5000
MINIO_READ_TIMEOUT_MS=5000

# 語言檢測配置
LANGUAGE_DETECTION_USE_AI=true
LANGUAGE_DETECTION_AI_PROVIDER=openai
LANGUAGE_DETECTION_DEFAULT_CHINESE=zh-tw
# Image overlay is fail-closed; disable immediately without disabling OCR/text translation.
IMAGE_TRANSLATION_MAX_FILE_SIZE_BYTES=10485760
IMAGE_TRANSLATION_MAX_DIMENSION=4096
IMAGE_TRANSLATION_MAX_PIXELS=16000000
IMAGE_TRANSLATION_LOW_CONFIDENCE_THRESHOLD=0.60
IMAGE_TRANSLATION_OVERLAY_ENABLED=true
IMAGE_TRANSLATION_MAX_REGION_AREA_RATIO=0.12
IMAGE_TRANSLATION_MAX_TOTAL_MASK_RATIO=0.35
# Optional. Leave blank to send MinIO/DWZ URLs directly in LINE ImageMessage.
IMAGE_PROXY_PUBLIC_BASE_URL=
IMAGE_PROXY_TOKEN_TTL=PT55M
IMAGE_PROXY_MAX_ENTRIES=10000
IMAGE_PROXY_PREVIEW_MAX_BYTES=1048576
IMAGE_PROXY_CONTENT_CACHE_TTL=PT5M
IMAGE_PROXY_CONTENT_CACHE_ENTRIES=256
SHORT_URL_ENABLED=false
# 木雷 API：同主機固定 port 可用 http://127.0.0.1:18080；遠端必須 HTTPS
DWZ_API_BASE_URL=http://127.0.0.1:18080
DWZ_API_TOKEN=your_dwz_bearer_token
# Optional. Blank lets 木雷 use its default short domain.
DWZ_SHORT_DOMAIN=
DWZ_WORKSPACE_ID=
SHORT_URL_TTL=PT55M
